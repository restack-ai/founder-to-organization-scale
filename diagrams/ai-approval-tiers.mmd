flowchart TB
L["Low risk\nDrafts, summaries, classifications"] --> LA["Agent may act autonomously"]
M["Moderate risk\nInternal reversible actions"] --> MA["Agent acts inside policy + audits"]
H["High risk\nExternal or production impact"] --> HA["Human approval before execution"]
C["Critical risk\nLegal, hiring, compensation, security exceptions"] --> CA["Human decides; agent only supports"]
